# 应用配置（所有变量都带 CADFENXI_ 前缀,由 backend/core/config.py 加载）

# 上传文件大小上限,默认 200 MB
# CADFENXI_UPLOAD_MAX_BYTES=209715200

# DWG 转 DXF 超时秒数,默认 120
# CADFENXI_CONVERT_TIMEOUT_SECONDS=120

# 转换器 stdout/stderr 单次截断字节数,默认 5000
# CADFENXI_CONVERTER_LOG_LIMIT=5000

# 图纸预览图最大宽度,默认 1800 px
# CADFENXI_PREVIEW_MAX_WIDTH=1800

# 缩略图最大宽度,默认 320 px
# CADFENXI_THUMBNAIL_MAX_WIDTH=320

# 允许跨域来源,JSON 列表形式
# CADFENXI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
