{
  "name": "drawing-ledger-ai-frontend",
  "private": true,
  "version": "v1.2.3-fast-import-stable",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "cross-env VITE_ANALYZE=1 vite build",
    "openapi:dump": "cd .. && python -c \"import json; from backend.main import app; print(json.dumps(app.openapi()))\" > frontend/src/api/openapi-schema.json",
    "openapi:types": "openapi-typescript src/api/openapi-schema.json -o src/api/openapi.gen.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "cross-env": "^10.1.0",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.0.1"
  }
}

